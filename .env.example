# Primary Database Connection
# Replace with your own PostgreSQL connection string
DATABASE_URL="postgresql://user:password@localhost:5432/superblog_db?schema=public"

# The public URL of your Next.js application
NEXT_PUBLIC_API_URL="http://localhost:3000"

# --- Authentication (Better Auth) ---

# Generate a strong, random 32 character string (e.g., using `openssl rand -base64 32`)
BETTER_AUTH_SECRET="generate_a_strong_random_secret_here"
# Must match your NEXT_PUBLIC_API_URL
BETTER_AUTH_URL="http://localhost:3000"

# --- OAuth Providers (Optional but recommended) ---

# GitHub OAuth Credentials
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# Google OAuth Credentials
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- Email Notifications & OTP Verification (Nodemailer) ---

# Configure your SMTP server details here
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
NODEMAILER_USER="your-email@gmail.com"
# For Gmail, use an App Password instead of your real password
NODEMAILER_APP_PASSWORD="your-app-password"

# Allowed email domains for registration (comma-separated, or set to your primary domain)
EMAIL_DOMAIN="your-email@gmail.com"
